 nb-switchrow\">\n        <label class=\"nb-switch\"><input type=\"checkbox\" class=\"svc-installed\"><span class=\"nb-slider\"></span> Installed as systemd service</label>\n        <label class=\"nb-switch\"><input type=\"checkbox\" class=\"svc-running\"><span class=\"nb-slider\"></span> Running (systemd)</label>\n        <button class=\"btn svc-restart\">Restart</button>\n      </div>\n      <div class=\"nb-form\">\n        <label><span class=\"lbl\">this host is a lighthouse</span><input type=\"checkbox\" class=\"f-amlighthouse\"></label>\n        <label><span class=\"lbl\">network interface</span><input type=\"text\" class=\"f-host\" placeholder=\"IP address to listen on\"></label>\n        <label><span class=\"lbl\">port</span><input type=\"number\" class=\"f-port\" placeholder=\"Port to listen on\"></label>\n        <label><span class=\"lbl\">private subnet</span><input type=\"text\" class=\"f-subnet\" placeholder=\"Example: 192.168.100.X/24\"></label>\n        <label><span class=\"lbl\">private ip address</span><input type=\"text\" class=\"f-ipaddr\" placeholder=\"This host's address on the overlay\"></label>\n        <label><span class=\"lbl\">groups</span><input type=\"text\" class=\"f-groups\" placeholder=\"Comma separated, no spaces\"></label>\n      </div>\n    </section>\n\n    <section class=\"nb-tabpane pane-lh\" hidden>\n      <div class=\"nb-row nb-row-between\">\n        <div class=\"lbl\">lighthouses</div>\n        <button class=\"btn btn-primary addlighthousebutton\">Add lighthouse</button>\n      </div>\n      <div class=\"nb-hint\">Publicly reachable hosts that members use to find each other. Changes apply when you save the configuration.</div>\n      <div class=\"lighthouselist\"></div>\n    </section>\n\n    <section class=\"nb-tabpane pane-mem\" hidden>\n      <div class=\"nb-row nb-row-between\">\n        <div class=\"lbl\">members</div>\n        <button class=\"btn btn-primary addmemberbutton\">Add member</button>\n      </div>\n      <div class=\"nb-hint nopeers-hint\" hidden>\n        No connected peers. Adding a member signs a certificate here and delivers\n        it to a connected peer &mdash; connect one in the\n        <a href=\"../peer/index.html\">Peers app</a> first.\n      </div>\n      <div class=\"memberlist\"></div>\n    </section>\n\n    <section class=\"nb-tabpane pane-adv\" hidden>\n      <label class=\"nb-switch\"><input type=\"checkbox\" class=\"f-useyaml\"><span class=\"nb-slider\"></span> Override the other tabs with raw YAML</label>\n      <textarea class=\"f-yaml mono\" rows=\"14\" spellcheck=\"false\"></textarea>\n    </section>\n\n    <footer class=\"nb-foot\">\n      <button class=\"btn btn-primary saveconfigbutton\">Save configuration</button>\n    </footer>\n  </main>\n\n  <div class=\"nb-modal\" hidden>\n    <div class=\"nb-modal-card popmeup\"></div>\n  </div>\n</div>\n","old":"<div class='data-control' data-control='app:ui:{}'></div>\n<div class='background'></div>\n<div class='wrap homepage' style='display:none;'>\n  <div class='titlebar'>\n    <a href='../app/index.html'><img src='../app/asset/app/menu_icon.png' class='menuicon'></a>\n    Nebula\n  </div>\n  <div class='main'>\n    <div class='whichpeer'></div>\n    <div>\n      Installed Version:\n      <span class='nebulaversion'></span>\n      <a class=\"refreshversion\">\n        <img class=\"roundbutton-small\" src=\"../app/asset/app/refresh_icon-green.png\">\n      </a>      \n    </div>\n\n    <div class=\"releasemanagement\">\n      <br>\n      <button class=\"checkupdatebutton coloredbutton\">\n        Check for update\n      </button>\n      <div class='updatemsg'></div>\n      <br>\n      <div class='downloadselect'></div>\n      <br>\n      <button class=\"installupdatebutton coloredbutton\">\n        Install\n      </button>\n    </div>\n    \n    <div class=\"installappremotely\">\n      <button class=\"installappbutton coloredbutton\">\n        Install App\n      </button>\n      <button class=\"rebootpeerbutton coloredbutton\">\n        Reboot Device\n      </button>\n    </div>\n    \n\n    <div class=\"installednetworks\">\n      <h1>\n        <a class=\"addnetworkbutton\">\n          <img class=\"roundbutton smol\" src=\"../app/asset/app/add_icon.png\">\n        </a>\n        Networks\n      </h1>\n      <div class=\"foundnetworks\"></div>\n    </div>\n\n    \n  </div>\n</div>\n<div class='wrap networkpage' style='display:none;'>\n  <div class='titlebar network-titlebar'>\n    <img src='../app/asset/app/arrow-left.png' class='menuicon backbutton'>\n    Nebula / <span class=\"selectedpeername\">local</span> / <span class=\"selectednetworkname\"></span>\n  </div>\n  <div class='navbar network-navbar'>\n    <div class='navbar-tab network-tab selected' data-id='network-tab1'>Service</div>\n    <div class='navbar-tab network-tab' data-id='network-tab2'>Lighthouses</div>\n    <div class='navbar-tab network-tab' data-id='network-tab3'>Members</div>\n    <div class='navbar-tab network-tab' data-id='network-tab4'>Advanced</div>\n  </div>\n  <div class='main'>\n    <div class='tab-content network-tab1 selected' id='network-tab1'>\n      <h4 class='networkownerspan'></h4>\n      <div class='networkservicespan'></div>\n      <br>\n      <div class='networkrunningspan'></div>\n      <br>\n      <label class=\"plaincheckbox\">\n        <input type='checkbox' id='lighthousecheckbox' class='lighthousecheckbox'>\n        <span>Lighthouse</span>\n      </label>\n      <br><br>\n      <div class='textinputlabel'>Network Interface</div>\n      <input type='text' class='textinput networkhost' placeholder='IP Address to listen on'>\n      <br><br>\n      <div class='textinputlabel'>Port</div>\n      <input type='number' class='textinput networkport' placeholder='Port to listen on'>\n      <br><br>\n      <div class='textinputlabel'>Private Subnet</div>\n      <input type='text' class='textinput networksubnet' placeholder='Example: 192.168.100.X/24'>\n      <br><br>\n      <div class='textinputlabel'>Private IP Address</div>\n      <input type='text' class='textinput networkipaddr' placeholder='IP Address on this Nebula network'>\n      <br><br>\n      <div class='textinputlabel'>Groups</div>\n      <input type='text' class='textinput networkgroups' placeholder='Comma separated, no spaces'>\n      <br><br>\n    </div>\n    <div class='tab-content network-tab2' id='network-tab2'>\n      <h1>\n        <img class=\"addlighthousebutton roundbutton smol\" src=\"../app/asset/app/add_icon.png\">\n        Remote Lighthouses\n      </h1>\n      <div class='selectednetworklighthouses'></div>\n    </div>\n    <div class='tab-content network-tab3' id='network-tab3'>\n      <h1>\n        <img class=\"addmemberbutton roundbutton smol\" src=\"../app/asset/app/add_icon.png\">\n        Remote Members\n      </h1>\n      <div class=\"selectednetworkmembers\"></div>\n    </div>\n    <div class='tab-content network-tab4' id='network-tab4'>\n      <label class=\"plaincheckbox\">\n        <input type='checkbox' id='yaml-checkbox' class='yaml-checkbox'>\n        <span>Override settings in other tabs</span>\n      </label>\n      <br><br>\n      <div class='textinputlabel'>RAW YAML</div>\n      <textarea class=\"config-yml textinput\" type=\"text\" rows= \"10\" cols=\"60\" id=\"config-yml\" style=\"min-width:100%;\"></textarea>\n    </div>\n    <br>\n    <button class=\"saveconfigbutton coloredbutton\">\n      Save configuration\n    </button>\n  </div>\n</div>\n<div class='popmeup card hideme wrap'></div>","patch_id":"p2","time":1786447678053},{"author":"claude, nebula-idfix session 2026-08-11","facet":"css","label":"idfix fold: nebula css","new":"/* Nebula app — kit dialect (app.tokens contract v1). Layout only:\n   every color and type role comes from the tokens. */\n\n.nb-app { display: flex; flex-direction: column; height: 100vh; background: var(--ground); color: var(--text); }\n.nb-app .mono { font-family: var(--mono); }\n\n/* header */\n.nb-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.nb-home { color: var(--text-dim); text-decoration: none; font-size: 18px; }\n.nb-home:hover { color: var(--accent); }\n.nb-title { font-family: var(--disp); font-size: 16px; letter-spacing: 0.06em; }\n.nb-crumb { color: var(--text-dim); }\n.nb-crumb b { color: var(--text); font-weight: 600; }\n.nb-spacer { flex: 1; }\n.nb-peerbox { display: flex; align-items: center; gap: 8px; }\n.nb-peerbox select { background: var(--panel-2); color: var(--text); border: 1px solid var(--line); border-radius: 4px; padding: 4px 8px; }\n\n/* status strip */\n.nb-status { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--panel-2); border-bottom: 1px solid var(--line); }\n.nb-status.ok .nb-status-msg { color: var(--good); }\n.nb-status.err .nb-status-msg { color: var(--danger); }\n.nb-status.busy .nb-status-msg { color: var(--text-dim); }\n.nb-status-msg { white-space: pre-wrap; word-break: break-word; }\n.nb-status-x { margin-left: auto; color: var(--text-faint); }\n.nb-status-x:hover { color: var(--text); }\n\n/* main + panels */\n.nb-main { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 16px; }\n.nb-panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }\n.nb-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.nb-row-between { justify-content: space-between; }\n.nb-hint { color: var(--text-dim); font-size: 13px; line-height: 1.5; }\n.nb-hint a { color: var(--accent); }\n\n/* buttons */\n.btn { padding: 6px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--panel-2); color: var(--text); }\n.btn:hover { border-color: var(--accent-dim); }\n.btn-primary { background: var(--accent-dim); border-color: var(--accent-dim); color: var(--ground); font-weight: 600; }\n.btn-primary:hover { background: var(--accent); border-color: var(--accent); }\n.btn[disabled] { opacity: 0.5; cursor: default; }\n.btn-danger { color: var(--danger); }\n\n/* network list */\n.netrow { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--line-soft); border-radius: 5px; margin-top: 8px; cursor: pointer; background: var(--panel-2); }\n.netrow:hover { border-color: var(--accent-dim); }\n.netrow .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--text-faint); }\n.netrow .dot.on { background: var(--good); }\n.netrow .netname { font-weight: 600; }\n.netrow .badge { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px; border-radius: 8px; border: 1px solid var(--line); color: var(--text-dim); }\n.netrow .badge.owner { color: var(--accent); border-color: var(--accent-dim); }\n\n/* tabs */\n.nb-tabs { display: flex; gap: 2px; padding: 0 16px; background: var(--panel); border-bottom: 1px solid var(--line); }\n.nb-tab { padding: 10px 16px; color: var(--text-dim); border-bottom: 2px solid transparent; }\n.nb-tab:hover { color: var(--text); }\n.nb-tab.selected { color: var(--accent); border-bottom-color: var(--accent); }\n.nb-tabpane { display: flex; flex-direction: column; gap: 12px; padding: 16px; overflow-y: auto; flex: 1; }\n.networkpage { padding: 0; gap: 0; }\n.nb-foot { padding: 12px 16px; border-top: 1px solid var(--line); background: var(--panel); }\n\n/* switches */\n.nb-switch { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }\n.nb-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n.nb-slider { width: 34px; height: 18px; border-radius: 9px; background: var(--panel-3); border: 1px solid var(--line); position: relative; transition: background 0.15s; }\n.nb-slider::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: var(--text-dim); transition: transform 0.15s, background 0.15s; }\n.nb-switch input:checked + .nb-slider { background: var(--accent-dim); }\n.nb-switch input:checked + .nb-slider::after { transform: translateX(16px); background: var(--ground); }\n.nb-switch input:focus-visible + .nb-slider { outline: 2px solid var(--accent); outline-offset: 2px; }\n.nb-switch.busy { opacity: 0.5; pointer-events: none; }\n\n/* forms */\n.nb-form { display: flex; flex-direction: column; gap: 10px; max-width: 460px; }\n.nb-form label { display: flex; flex-direction: column; gap: 4px; }\n.nb-form input[type=text], .nb-form input[type=number], .nb-modal-card input[type=text], .nb-modal-card input[type=number] {\n  background: var(--panel-2); border: 1px solid var(--line); border-radius: 4px; color: var(--text); padding: 7px 9px; }\n.nb-form input[type=checkbox] { width: 16px; height: 16px; }\n.f-yaml { background: var(--panel-2); border: 1px solid var(--line); border-radius: 4px; color: var(--text); padding: 8px; min-height: 220px; }\n\n/* tables */\n.nb-table { width: 100%; border-collapse: collapse; }\n.nb-table th { text-align: left; font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); padding: 6px 8px; border-bottom: 1px solid var(--line); }\n.nb-table td { padding: 8px; border-bottom: 1px solid var(--line-soft); }\n.nb-table .peerid { font-family: var(--mono); font-size: 11px; color: var(--text-faint); }\n.nb-table .rowbtn { color: var(--text-dim); padding: 2px 6px; }\n.nb-table .rowbtn:hover { color: var(--accent); }\n.nb-table .rowbtn.danger:hover { color: var(--danger); }\n.nb-empty { color: var(--text-faint); padding: 10px 0; }\n\n/* modal */\n.nb-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center; z-index: 50; }\n.nb-modal-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; min-width: 340px; max-width: 92vw; max-height: 88vh; overflow-y: auto; }\n\n/* shared dialog chrome for the popup controls (styles inject globally) */\n.nbdlg { display: flex; flex-direction: column; color: var(--text); }\n.nbdlg-head { display: flex; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--line); }\n.nbdlg-title { font-family: var(--disp); letter-spacing: 0.04em; }\n.nbdlg-x { margin-left: auto; color: var(--text-faint); }\n.nbdlg-x:hover { color: var(--text); }\n.nbdlg-body { display: flex; flex-direction: column; gap: 10px; padding: 14px; min-width: 300px; }\n.nbdlg-body label { display: flex; flex-direction: column; gap: 4px; }\n.nbdlg-body input { background: var(--panel-2); border: 1px solid var(--line); border-radius: 4px; color: var(--text); padding: 7px 9px; }\n.nbdlg-err { color: var(--danger); font-size: 13px; }\n.nbdlg-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--line); }\n","old":".whichpeer{\n  margin-bottom:20px;\n}\n\n.installupdatebutton, .installappremotely, .installednetworks, .rebootpeerbutton, .networkpage{\n  display: none;\n}\n\n.network-titlebar {\n  padding-bottom:0px !important;\n}\n\n.network-navbar {\n  top:40px !important;\n}\n\n.backbutton{\n  cursor:pointer;\n}\n\n.member_peer{\n  font-size:xx-small;\n}\n\n.smol {\n  width:20px;\n}","patch_id":"p3","time":1786447678054},{"author":"claude, nebula-idfix session 2026-08-11","facet":"js","label":"idfix fold: nebula js","new":"var me = this;\nvar ME = $('#'+me.UUID)[0];\n\n// All state lives here — never parsed back out of the DOM.\nvar S = {\n  peer: null,          // selected target peer uuid, or null for local\n  mypeerid: null,\n  mypeername: null,\n  networks: {},        // name -> {name, owner, service, running, config}\n  selected: null,      // name of the open network\n  lighthouses: {},     // working copy for the open network: peerid -> {private_ip, public_ip, port}\n  members: {},\n  releases: null\n};\n\n// ---- outcomes (the envelope is 'ok' even when the command failed:\n// object commands carry the verdict in data.status, string commands in\n// an ERROR prefix — check all three) ----\nfunction outcome(result){\n  if (!result) return { ok:false, msg:'no response' };\n  if (result.status != 'ok') return { ok:false, msg: result.msg || 'request failed' };\n  var d = result.data;\n  if (d && typeof d == 'object' && d.status == 'err') return { ok:false, msg: d.msg || 'command failed' };\n  if (typeof d == 'string' && d.indexOf('ERROR') == 0) return { ok:false, msg: d };\n  return { ok:true, msg: (typeof d == 'string') ? d : '' };\n}\n\n// ---- status strip: quiet success, readable errors, sticky until dismissed ----\nvar statusTimer = null;\nfunction status(msg, kind){\n  var el = $(ME).find('.nb-status');\n  if (statusTimer) { clearTimeout(statusTimer); statusTimer = null; }\n  if (!msg) { el.attr('hidden', true); return; }\n  el.removeAttr('hidden').removeClass('ok err busy').addClass(kind || 'ok');\n  el.find('.nb-status-msg').text(msg);\n  if (kind == 'ok') statusTimer = setTimeout(function(){ el.attr('hidden', true); }, 4000);\n}\n$(ME).find('.nb-status-x').click(function(){ status(null); });\n\nfunction busy(sel, on){\n  var el = $(ME).find(sel);\n  if (on) el.attr('disabled', true).addClass('busy');\n  else el.removeAttr('disabled').removeClass('busy');\n}\n\n// ---- boot ----\nme.ready = function(){\n  json('../peer/info', null, function(result){\n    S.mypeerid = result.data.uuid;\n    S.mypeername = result.data.name;\n    installControl($(ME).find('.whichpeer')[0], 'peer', 'peer_select', function(){}, {\n      local: true,\n      connectedonly: true,\n      ready: refresh,\n      cb: function(val){\n        S.peer = (val == 'local') ? null : val;\n        showHome();\n        refresh();\n      }\n    });\n  });\n};\n\nfunction peerName(id){\n  if (id == null || id == 'local') return 'local';\n  if (id == S.mypeerid) return S.mypeername;\n  return (document.peers && document.peers[id]) ? document.peers[id].name : id;\n}\n\n// ---- home: engine + network list ----\nfunction refresh(){\n  $(ME).find('.nebulaversion').text('checking…');\n  $(ME).find('.engine-remote').attr('hidden', true);\n  send_info(function(result){\n    var o = outcome(result);\n    if (!o.ok || !result.data || !result.data.tag_name){\n      $(ME).find('.nebulaversion').text('unavailable');\n      $(ME).find('.installednetworks').attr('hidden', true);\n      // a remote peer without the app gets the in-app P2P install path\n      if (S.peer) $(ME).find('.engine-remote').removeAttr('hidden');\n      else if (!o.ok) status('This instance did not answer: ' + o.msg, 'err');\n      return;\n    }\n    var d = result.data;\n    if (d.tag_name == 'Not Installed'){\n      $(ME).find('.nebulaversion').text('not installed — fetch a release below');\n    } else {\n      $(ME).find('.nebulaversion').text(d.tag_name + ' (' + d.binary_name + ')');\n    }\n    renderNetworks(d.networks || []);\n    $(ME).find('.installednetworks').removeAttr('hidden');\n  }, S.peer);\n}\n$(ME).find('.refreshversion').click(refresh);\n\nfunction renderNetworks(list){\n  S.networks = {};\n  var box = $(ME).find('.foundnetworks').empty();\n  if (!list.length){\n    box.append($('<div class=\"nb-empty\">No networks yet.</div>'));\n    return;\n  }\n  for (var i in list){\n    var n = list[i];\n    S.networks[n.name] = n;\n    var owned = n.owner == 'local';\n    var row = $('<div class=\"netrow\"></div>').attr('data-name', n.name);\n    row.append($('<span class=\"dot\"></span>').toggleClass('on', !!n.running));\n    row.append($('<span class=\"netname\"></span>').text(n.name));\n    row.append($('<span class=\"badge\"></span>').toggleClass('owner', owned)\n      .text(owned ? 'owner' : 'joined · ' + peerName(n.owner)));\n    if (n.service) row.append($('<span class=\"badge\">service</span>'));\n    row.click(function(){ openNetwork($(this).attr('data-name')); });\n    box.append(row);\n  }\n}\n\n// ---- engine